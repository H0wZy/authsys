# DSN
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=goauthdb
SSL_MODE=disable

# JWT
# Generate with: openssl rand -base64 48
JWT_SECRET=
# JWT_ISSUER=authsys

# Optional
# PORT=8080

# Goose
# The CLI loads this file automatically. Expansion is top-down, so the DSN
# block above must be filled in before these lines.
GOOSE_DRIVER=postgres
GOOSE_DBSTRING="postgres://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?sslmode=${SSL_MODE}"
GOOSE_MIGRATION_DIR=migrations
